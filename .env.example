APP_NAME=Airport GIS API
APP_ENV=development
API_V1_PREFIX=/api/v1
API_PORT=8000

POSTGRES_DB=airport_gis
POSTGRES_USER=airport_gis
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5434

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
